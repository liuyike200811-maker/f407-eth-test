{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译 (make)",
      "type": "shell",
      "command": "make -j",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "编译工程，等同 Keil 的 Build"
    },
    {
      "label": "清理 (make clean)",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": [],
      "detail": "删除 build 产物，等同 Keil 的 Clean"
    },
    {
      "label": "烧录到板子 (openocd)",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f", "interface/stlink.cfg",
        "-f", "target/stm32f4x.cfg",
        "-c", "program build/f407-eth-test.elf verify reset exit"
      ],
      "dependsOn": "编译 (make)",
      "problemMatcher": [],
      "detail": "先编译再烧录，等同 Keil 的 Download。烧完自动复位运行"
    }
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试/烧录 (ST-Link)",
      "cwd": "${workspaceFolder}",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/f407-eth-test.elf",
      "device": "STM32F407ZGTx",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "runToEntryPoint": "main",
      "preLaunchTask": "编译 (make)",
      "showDevDebugOutput": "none"
    }
  ]
}
